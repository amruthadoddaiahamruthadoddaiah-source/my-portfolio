# Resend email configuration (optional)
# Add these to .env.local for local development, and to Vercel for production.

# Your Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Email address that should receive contact form messages
CONTACT_TO_EMAIL=

# Optional: custom "from" address (defaults to onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# Optional: public site URL for Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
